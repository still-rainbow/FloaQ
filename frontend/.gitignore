# Node · Vite · React
# OS · 편집기 · 시크릿은 저장소 루트 .gitignore 가 맡는다.
# 출처: github/gitignore (Node)

# ── 의존성 ──
node_modules/
.pnp
.pnp.js
jspm_packages/

# ── 빌드 산출물 ──
dist/
dist-ssr/
build/
.output/

# ── 캐시 ──
.vite/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm

# ── 테스트 · 커버리지 ──
coverage/
*.lcov
.nyc_output/

# ── 잡파일 ──
*.tgz
.yarn-integrity
.node_repl_history
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
